---
import { render, type CollectionEntry } from "astro:content";
import BackButton from "./BackButton.astro";
import ButtonLink from "./ButtonLink.astro";
import Layout from "./Layout.astro";
import { getCuriosityNotePath, sortCuriosityNotes } from "../config/curiosity";
import { absoluteUrl } from "../config/seo";
import { site } from "../config/site";

interface Props {
  entry: CollectionEntry<"curiosity">;
  notes: CollectionEntry<"curiosity">[];
}

const { entry, notes } = Astro.props;
const { Content } = await render(entry);
const sortedNotes = sortCuriosityNotes(notes);
const publishedDate = entry.data.date?.toISOString();
const modifiedDate = entry.data.dateModified?.toISOString();
const tldr = entry.data.tldr?.trim();
const title = `${entry.data.title} | Notes from talking to people`;
const description =
  entry.data.summary ??
  entry.data.description ??
  entry.data.subtitle ??
  `A conversation note with ${entry.data.name} by ${site.name}.`;
const canonical = getCuriosityNotePath(entry, sortedNotes);
const canonicalUrl = absoluteUrl(canonical);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.data.title,
    author: {
      "@type": "Person",
      name: site.name,
      url: site.url,
    },
    ...(publishedDate ? { datePublished: publishedDate } : {}),
    ...(modifiedDate ? { dateModified: modifiedDate } : {}),
    description,
    mainEntityOfPage: canonicalUrl,
    image: absoluteUrl(site.ogImage),
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  author={site.name}
  structuredData={structuredData}
>
  <article class="article-container curiosity-note">
    <BackButton href="/curiosity" label="All notes" />

    <p class="note-intro type-p1">
      I had coffee with {
        entry.data.website ? (
          <a href={entry.data.website} target="_blank" rel="noreferrer">{entry.data.name}</a>
        ) : (
          <span>{entry.data.name}</span>
        )
      }.<br />
      Notes below.
    </p>

    <header class="note-header">
      <h1 class="type-h2">{entry.data.title}</h1>
      <p class="type-p1">{entry.data.subtitle}</p>
    </header>

    {
      tldr && (
        <section class="note-tldr" aria-label="TLDR">
          <h2 class="type-n1">TLDR</h2>
          <p class="type-n0">{tldr}</p>
        </section>
      )
    }

    <div class="article-content note-content">
      <Content />
    </div>
  </article>

  <section class="article-container article-cta" aria-label="More">
    <h2 class="type-cta">
      See what else I build.<br />
      Or read more notes.
    </h2>
    <p class="article-cta__text type-p1">Got a thought, a question, or someone worth meeting?</p>
    <div class="article-cta__buttons">
      <ButtonLink href="/#work">See what else I build</ButtonLink>
      <ButtonLink href="/curiosity" variant="secondary">See more notes</ButtonLink>
    </div>
  </section>
</Layout>

<style>
  .curiosity-note {
    padding-top: var(--top-button-offset);
  }

  .note-intro {
    margin-top: var(--note-intro-gap);
  }

  .note-intro a {
    color: var(--color-black);
    font-weight: 400;
    text-decoration: underline;
  }

  .note-header {
    display: grid;
    gap: 20px;
    margin-top: var(--note-title-gap);
  }

  .note-tldr {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .note-content {
    margin-top: var(--article-heading-gap-mobile);
  }

  .article-cta {
    display: grid;
    gap: 20px;
    margin-top: 140px;
    padding-bottom: 120px;
  }

  .article-cta__text {
    display: none;
  }

  .article-cta__buttons {
    display: grid;
    gap: 15px;
    margin-top: 70px;
  }

  .article-cta__buttons :global(.button-link) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .curiosity-note {
      padding-top: var(--top-button-offset);
    }

    .note-header {
      margin-top: var(--note-title-gap);
    }

    .note-content {
      margin-top: var(--article-heading-gap-desktop);
    }

    .article-cta {
      margin-top: 160px;
      padding-bottom: 150px;
    }

    .article-cta__text {
      display: block;
    }

    .article-cta__buttons {
      display: flex;
      margin-top: 50px;
    }

    .article-cta__buttons :global(.button-link) {
      width: auto;
    }
  }
</style>
