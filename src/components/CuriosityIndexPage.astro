---
import { getCollection } from "astro:content";
import BackButton from "./BackButton.astro";
import ButtonLink from "./ButtonLink.astro";
import CuriosityCard from "./CuriosityCard.astro";
import Layout from "./Layout.astro";
import { sortCuriosityNotes } from "../config/curiosity";
import { absoluteUrl, personJsonLd } from "../config/seo";
import { site } from "../config/site";

const notes = await getCollection("curiosity");
const sortedNotes = sortCuriosityNotes(notes);
const mobileInitialVisibleCount = 6;
const desktopInitialVisibleCount = 8;
const revealCount = 6;
const hasMoreNotes = sortedNotes.length > mobileInitialVisibleCount;
const title = "Notes from talking to people | Coen Claassen";
const description =
  "Notes from conversations with people about work, ideas, questions, and the things that stayed with Coen Claassen.";
const canonical = "/curiosity";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Notes from talking to people",
    url: absoluteUrl(canonical),
    description,
    creator: personJsonLd(),
  },
];
---

<Layout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <div class="curiosity-page" data-curiosity-page>
    <div class="site-container">
      <BackButton href="/" ariaLabel="Back home" />
    </div>

    <header class="site-container curiosity-header">
      <h1>
        Notes from<br class="md:hidden" />
        talking to people
      </h1>
      <p class="type-p2">
        Everyone has something interesting going on.
        You just have to ask the right questions.<br class="hidden md:block" />
        These are a few conversations I keep thinking about.
      </p>
    </header>

    {
      sortedNotes.length > 0 ? (
        <section class="site-container curiosity-grid-section" aria-label="Curiosity notes">
          <div
            class="curiosity-grid"
            data-curiosity-grid
            data-initial-mobile={mobileInitialVisibleCount}
            data-initial-desktop={desktopInitialVisibleCount}
            data-reveal-count={revealCount}
          >
            {sortedNotes.map((note, index) => (
              <div class:list={[index >= desktopInitialVisibleCount && "hidden"]} data-curiosity-item>
                <CuriosityCard note={note} notes={sortedNotes} index={index} />
              </div>
            ))}
            <button class="load-more-card curiosity-load-card" type="button" data-load-more-notes hidden={!hasMoreNotes}>
              Load more notes
            </button>
          </div>

          <button class="curiosity-load-inline" type="button" data-load-more-notes hidden={!hasMoreNotes}>
            Load more notes
          </button>
        </section>
      ) : (
        <div class="site-container">
          <p>No curiosity notes have been added yet.</p>
        </div>
      )
    }

    <section class="site-container curiosity-bottom-cta" aria-label="Contact">
      <p class="curiosity-bottom-cta__desktop type-p2">
        Talk to people. It works.<br />
        Got a thought, a question, or someone worth meeting?
      </p>
      <div class="curiosity-bottom-cta__mobile">
        <h2 class="type-cta">
          Talk to people.<br />
          It works.
        </h2>
        <p class="type-p1">Got a thought, a question, or someone worth meeting?</p>
      </div>
      <div class="curiosity-buttons">
        <ButtonLink href={site.emailHref}>Email me</ButtonLink>
        <ButtonLink href="/" variant="secondary">Back home</ButtonLink>
      </div>
    </section>
  </div>
</Layout>

<style>
  .curiosity-page {
    padding: var(--top-button-offset) 0 70px;
  }

  .curiosity-header {
    display: grid;
    gap: 20px;
    margin-top: var(--top-content-offset);
  }

  .curiosity-grid-section {
    margin-top: 50px;
  }

  .curiosity-grid {
    display: grid;
    gap: 15px;
  }

  .curiosity-load-card {
    display: none;
    font-family: var(--type-p2-family);
    font-size: var(--type-p2-mobile-size);
    font-weight: var(--type-p2-weight);
    line-height: var(--type-p2-mobile-line-height);
  }

  .curiosity-load-card[hidden],
  .curiosity-load-inline[hidden] {
    display: none;
  }

  .curiosity-load-inline {
    display: inline-flex;
    width: 100%;
    min-height: var(--button-height);
    align-items: center;
    justify-content: center;
    margin-top: 50px;
    border: var(--stroke-weight) solid var(--color-stroke);
    border-radius: var(--button-radius);
    background: var(--color-white);
    box-shadow: var(--soft-shadow);
    color: var(--color-black);
    cursor: pointer;
    font-family: var(--type-btn-family);
    font-size: var(--type-btn-mobile-size);
    font-weight: var(--type-btn-weight);
    line-height: var(--type-btn-mobile-line-height);
    transition:
      transform var(--motion-transition),
      opacity var(--motion-transition);
  }

  .curiosity-load-inline:hover,
  .curiosity-load-inline:focus-visible {
    opacity: 0.9;
    transform: translateY(var(--motion-hover-y));
  }

  .curiosity-bottom-cta {
    display: grid;
    gap: 20px;
    margin-top: var(--layout-spacer);
  }

  .curiosity-bottom-cta__desktop {
    display: none;
  }

  .curiosity-bottom-cta__mobile {
    display: grid;
    gap: 20px;
  }

  .curiosity-buttons {
    display: grid;
    gap: 15px;
    margin-top: 50px;
  }

  .curiosity-buttons :global(.button-link) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .curiosity-page {
      padding: var(--top-button-offset) 0 var(--layout-spacer);
    }

    .curiosity-header {
      margin-top: var(--top-content-offset);
    }

    .curiosity-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .curiosity-load-card {
      display: block;
      font-size: var(--type-p2-desktop-size);
      font-weight: var(--type-p2-desktop-weight);
      line-height: var(--type-p2-desktop-line-height);
    }

    .curiosity-load-inline {
      display: none;
    }

    .curiosity-bottom-cta {
      gap: 50px;
      margin-top: 50px;
    }

    .curiosity-bottom-cta__desktop {
      display: block;
    }

    .curiosity-bottom-cta__mobile {
      display: none;
    }

    .curiosity-buttons {
      display: flex;
      margin-top: 0;
    }

    .curiosity-buttons :global(.button-link) {
      width: auto;
    }
  }
</style>

<script>
  const curiosityPage = document.querySelector("[data-curiosity-page]");
  const curiosityGrid = curiosityPage?.querySelector("[data-curiosity-grid]");

  if (curiosityGrid) {
    const items = Array.from(curiosityGrid.querySelectorAll("[data-curiosity-item]"));
    const loadMoreButtons = Array.from(curiosityPage?.querySelectorAll("[data-load-more-notes]") ?? []);
    const prefersDesktop = window.matchMedia("(min-width: 768px)");
    const revealCount = Number(curiosityGrid.getAttribute("data-reveal-count") ?? 6);
    const mobileInitial = Number(curiosityGrid.getAttribute("data-initial-mobile") ?? 6);
    const desktopInitial = Number(curiosityGrid.getAttribute("data-initial-desktop") ?? 8);
    let visibleCount = prefersDesktop.matches ? desktopInitial : mobileInitial;

    const updateVisibleItems = () => {
      const responsiveInitial = prefersDesktop.matches ? desktopInitial : mobileInitial;
      visibleCount = Math.max(visibleCount, responsiveInitial);

      items.forEach((item, index) => {
        item.classList.toggle("hidden", index >= visibleCount);
      });

      loadMoreButtons.forEach((button) => {
        button.toggleAttribute("hidden", visibleCount >= items.length);
      });
    };

    loadMoreButtons.forEach((button) => {
      button.addEventListener("click", () => {
        visibleCount += revealCount;
        updateVisibleItems();
      });
    });

    prefersDesktop.addEventListener("change", updateVisibleItems);
    updateVisibleItems();
  }
</script>
