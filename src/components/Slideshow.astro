---
import { readdirSync } from "node:fs";
import { join } from "node:path";
import { ChevronLeft, ChevronRight, Maximize2, Minimize2 } from "@lucide/astro";

interface Props {
  label?: string;
}

const { label = "Selected work slideshow" } = Astro.props;
const slidesDirectory = join(process.cwd(), "public", "images", "slides");
const getSlideNumber = (filename: string) => Number(filename.match(/\d+/)?.[0] ?? 0);
const slides = readdirSync(slidesDirectory)
  .filter((filename) => filename.endsWith(".webp") && /\d+/.test(filename))
  .sort((a, b) => getSlideNumber(a) - getSlideNumber(b) || a.localeCompare(b))
  .map((filename) => `/images/slides/${filename}`);
---

<section class="work-slideshow" aria-label={label} data-slideshow>
  <div class="work-slideshow__stage">
    {
      slides.map((src, index) => (
        <img
          class:list={["work-slideshow__image", index === 0 && "is-active"]}
          src={src}
          alt={`Selected work slide ${index + 1}`}
          loading={index === 0 ? "eager" : "lazy"}
          data-slide
        />
      ))
    }
  </div>

  <div class="work-slideshow__controls" data-slideshow-controls>
    <button type="button" aria-label="Previous slide" data-slide-prev>
      <ChevronLeft size={18} aria-hidden="true" />
    </button>
    <button type="button" aria-label="View slideshow fullscreen" data-slide-fullscreen>
      <span data-fullscreen-open><Maximize2 size={17} aria-hidden="true" /></span>
      <span data-fullscreen-close hidden><Minimize2 size={17} aria-hidden="true" /></span>
    </button>
    <button type="button" aria-label="Next slide" data-slide-next>
      <ChevronRight size={18} aria-hidden="true" />
    </button>
  </div>
</section>

<style>
  .work-slideshow {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    overflow: hidden;
    border-radius: var(--card-radius);
    background: #f4f4f4;
  }

  .work-slideshow__stage,
  .work-slideshow__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .work-slideshow__image {
    max-width: none;
    object-fit: cover;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .work-slideshow__image.is-active {
    opacity: 1;
  }

  .work-slideshow__controls {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 2;
    display: none;
    gap: 10px;
  }

  .work-slideshow__controls button {
    display: inline-flex;
    width: var(--button-height);
    height: var(--button-height);
    align-items: center;
    justify-content: center;
    border: var(--stroke-weight) solid rgba(255, 255, 255, 0.72);
    border-radius: var(--button-radius);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--soft-shadow);
    color: var(--color-black);
    cursor: pointer;
    transition:
      transform var(--motion-transition),
      opacity var(--motion-transition);
  }

  .work-slideshow__controls button:hover,
  .work-slideshow__controls button:focus-visible {
    opacity: 0.86;
    transform: translateY(var(--motion-hover-y));
  }

  .work-slideshow:fullscreen {
    width: 100vw;
    height: 100vh;
    min-height: 100vh;
    border-radius: 0;
    background: #000000;
  }

  .work-slideshow:fullscreen .work-slideshow__controls {
    display: flex;
  }

  @media (min-width: 768px) {
    .work-slideshow {
      aspect-ratio: auto;
      height: var(--slideshow-height);
      border-radius: 0;
    }

    .work-slideshow__controls {
      display: flex;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-slideshow]").forEach((slideshow) => {
    const slides = Array.from(slideshow.querySelectorAll("[data-slide]"));
    const previousButton = slideshow.querySelector("[data-slide-prev]");
    const nextButton = slideshow.querySelector("[data-slide-next]");
    const fullscreenButton = slideshow.querySelector("[data-slide-fullscreen]");
    const fullscreenOpenIcon = slideshow.querySelector("[data-fullscreen-open]");
    const fullscreenCloseIcon = slideshow.querySelector("[data-fullscreen-close]");
    const controls = slideshow.querySelector("[data-slideshow-controls]");
    const prefersDesktop = window.matchMedia("(min-width: 768px)");
    const intervalValue = Number(
      window.getComputedStyle(document.documentElement).getPropertyValue("--slideshow-interval").trim(),
    );
    const interval = Number.isFinite(intervalValue) && intervalValue > 0 ? intervalValue : 4000;
    let currentIndex = 0;
    let autoplayId;

    const showSlide = (nextIndex) => {
      if (!slides.length) return;

      slides[currentIndex]?.classList.remove("is-active");
      currentIndex = (nextIndex + slides.length) % slides.length;
      slides[currentIndex]?.classList.add("is-active");
    };

    const stopAutoplay = () => {
      window.clearInterval(autoplayId);
      autoplayId = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      autoplayId = window.setInterval(() => showSlide(currentIndex + 1), interval);
    };

    const lockLandscape = async () => {
      try {
        await screen.orientation?.lock?.("landscape");
      } catch {
        // Orientation lock is optional and unsupported on many browsers.
      }
    };

    const unlockOrientation = () => {
      try {
        screen.orientation?.unlock?.();
      } catch {
        // Keep fullscreen behavior working when orientation APIs are unavailable.
      }
    };

    const enterFullscreen = async () => {
      if (document.fullscreenElement === slideshow) return;

      await slideshow.requestFullscreen?.();

      if (!prefersDesktop.matches) {
        await lockLandscape();
      }
    };

    const exitFullscreen = () => {
      if (document.fullscreenElement === slideshow) {
        document.exitFullscreen?.();
      }
    };

    previousButton?.addEventListener("click", (event) => {
      event.stopPropagation();
      showSlide(currentIndex - 1);
    });

    nextButton?.addEventListener("click", (event) => {
      event.stopPropagation();
      showSlide(currentIndex + 1);
    });

    fullscreenButton?.addEventListener("click", (event) => {
      event.stopPropagation();

      if (document.fullscreenElement === slideshow) {
        exitFullscreen();
      } else {
        enterFullscreen();
      }
    });

    controls?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    slideshow.addEventListener("click", () => {
      if (!prefersDesktop.matches) {
        enterFullscreen();
      }
    });

    document.addEventListener("fullscreenchange", () => {
      const isFullscreen = document.fullscreenElement === slideshow;

      fullscreenButton?.setAttribute("aria-label", isFullscreen ? "Exit slideshow fullscreen" : "View slideshow fullscreen");
      fullscreenOpenIcon?.toggleAttribute("hidden", isFullscreen);
      fullscreenCloseIcon?.toggleAttribute("hidden", !isFullscreen);

      if (isFullscreen) {
        stopAutoplay();
      } else {
        unlockOrientation();
        startAutoplay();
      }
    });

    startAutoplay();
  });
</script>
