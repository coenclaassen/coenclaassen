---
import type { CollectionEntry } from "astro:content";
import { getCuriosityNotePath } from "../config/curiosity";

interface Props {
  note: CollectionEntry<"curiosity">;
  notes: CollectionEntry<"curiosity">[];
  index?: number;
}

const { note, notes } = Astro.props;
---

<a class="curiosity-card" href={getCuriosityNotePath(note, notes)} aria-label={`Read notes: ${note.data.title}`}>
  <article class="curiosity-card__content">
    <p class="curiosity-card__title">{note.data.title}</p>
    <p class="curiosity-card__meta">With {note.data.name}</p>
  </article>
</a>

<style>
  .curiosity-card__content {
    display: grid;
    gap: 2px;
  }

  .curiosity-card__title {
    color: var(--color-black);
    font-family: var(--type-p2-family);
    font-size: var(--type-p2-mobile-size);
    font-weight: var(--type-p2-weight);
    line-height: var(--type-p2-mobile-line-height);
  }

  .curiosity-card__meta {
    color: var(--color-grey);
    font-family: var(--type-p3-family);
    font-size: var(--type-p3-mobile-size);
    font-weight: var(--type-p3-weight);
    line-height: var(--type-p3-mobile-line-height);
  }

  @media (min-width: 768px) {
    .curiosity-card__title {
      font-size: var(--type-p2-desktop-size);
      font-weight: var(--type-p2-desktop-weight);
      line-height: var(--type-p2-desktop-line-height);
    }

    .curiosity-card__meta {
      font-size: var(--type-p3-desktop-size);
      font-weight: var(--type-p3-desktop-weight);
      line-height: var(--type-p3-desktop-line-height);
    }
  }
</style>
