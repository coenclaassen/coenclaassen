---
import { getCollection } from "astro:content";
import ButtonLink from "./ButtonLink.astro";
import CuriosityCard from "./CuriosityCard.astro";
import Layout from "./Layout.astro";
import Slideshow from "./Slideshow.astro";
import { sortCuriosityNotes } from "../config/curiosity";
import { absoluteUrl, personJsonLd } from "../config/seo";
import { site } from "../config/site";

const notes = await getCollection("curiosity");
const sortedNotes = sortCuriosityNotes(notes);
const latestNotes = sortedNotes.slice(0, 2);
const title = site.title;
const description = site.description;
const canonical = "/";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: absoluteUrl(canonical),
    description,
  },
  personJsonLd(),
];
---

<Layout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <section class="home-view home-view--hero">
    <div class="site-container">
      <div class="home-copy">
        <h1>
          Somehow,<br />
          you ended up here.
        </h1>
        <p class="type-p1">This is where you&rsquo;ll find stuff I&rsquo;ve built and things I think about.</p>
      </div>
    </div>
  </section>

  <section id="work" class="home-view home-view--work">
    <div class="site-container">
      <div class="home-copy home-copy--work">
        <h2>
          <span>Products</span>
          <span class="md:inline">I&rsquo;ve helped build</span>
        </h2>
        <p class="type-p2">
          My job is finding direction before the chaos turns into cost.<br class="hidden md:block" />
          I turn half-ideas and &ldquo;this will never work&rdquo; into things teams can actually build and ship.
        </p>
      </div>

      <div class="home-slideshow-wrap">
        <Slideshow />
      </div>
    </div>
  </section>

  <section class="home-view home-view--notes">
    <div class="site-container">
      <div class="home-copy home-copy--notes">
        <h3>Notes from talking to people</h3>
        <p class="type-p2">
          Everyone has something interesting going on.
          You just have to ask the right questions.<br class="hidden md:block" />
          These are a few conversations I keep thinking about.
        </p>
      </div>

      <div class="home-notes-grid">
        {latestNotes.map((note, index) => <CuriosityCard note={note} notes={sortedNotes} index={index} />)}
        <a class="load-more-card home-more-card hidden md:block" href="/curiosity">
          <span>See more notes.</span>
        </a>
      </div>

      <div class="home-notes-button md:hidden">
        <ButtonLink href="/curiosity" variant="secondary">See more notes</ButtonLink>
      </div>
    </div>
  </section>

  <section id="contact" class="home-view home-view--contact">
    <div class="site-container">
      <div class="home-copy home-copy--contact">
        <h2 class="type-cta">Still here?</h2>
        <p class="type-p1">
          If you made it this far,<br class="md:hidden" />
          we probably get along.
        </p>
        <div class="home-buttons">
          <ButtonLink href={site.emailHref}>Email me</ButtonLink>
          <ButtonLink href="/about" variant="secondary">More about me</ButtonLink>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-view {
    display: flex;
    align-items: center;
    background: var(--color-white);
  }

  .home-view--hero {
    min-height: 100svh;
  }

  .home-view--work {
    min-height: auto;
    padding: 80px 0;
  }

  .home-view--notes {
    min-height: auto;
    padding: 80px 0;
  }

  .home-view--contact {
    align-items: flex-start;
    min-height: auto;
    padding-top: var(--layout-spacer);
    padding-bottom: 70px;
  }

  .home-copy {
    display: grid;
    max-width: 560px;
    gap: 20px;
  }

  .home-copy--work h2 span {
    display: block;
  }

  .home-slideshow-wrap {
    margin-top: 50px;
  }

  .home-notes-grid {
    display: grid;
    gap: 15px;
    margin-top: 50px;
  }

  .home-more-card {
    display: none;
    color: var(--color-black);
    font-family: var(--type-p2-family);
    font-size: var(--type-p2-mobile-size);
    font-weight: var(--type-p2-weight);
    line-height: var(--type-p2-mobile-line-height);
  }

  .home-notes-button {
    margin-top: 50px;
  }

  .home-notes-button :global(.button-link),
  .home-buttons :global(.button-link) {
    width: 100%;
  }

  .home-buttons {
    display: grid;
    gap: 15px;
    margin-top: 70px;
  }

  @media (min-width: 768px) {
    .home-view--contact {
      align-items: center;
      min-height: 100svh;
      padding-top: 0;
      padding-bottom: 0;
    }

    .home-view--notes {
      min-height: 100svh;
      padding: 0;
    }

    .home-view--work {
      display: block;
      min-height: auto;
      padding: 0;
    }

    .home-copy--work {
      min-height: 40vh;
      align-content: center;
      max-width: none;
    }

    .home-copy--work h2 span {
      display: inline;
    }

    .home-slideshow-wrap {
      width: 100vw;
      margin-top: 0;
      margin-left: calc(50% - 50vw);
    }

    .home-copy--notes {
      max-width: none;
    }

    .home-notes-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 50px;
    }

    .home-more-card {
      display: block;
      font-size: var(--type-p2-desktop-size);
      font-weight: var(--type-p2-desktop-weight);
      line-height: var(--type-p2-desktop-line-height);
    }

    .home-buttons {
      display: flex;
      margin-top: 0;
    }

    .home-buttons :global(.button-link) {
      width: auto;
    }

    .home-copy--contact {
      gap: 20px;
    }
  }
</style>
