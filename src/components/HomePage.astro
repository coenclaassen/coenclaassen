---
import { getCollection } from "astro:content";
import ButtonLink from "./ButtonLink.astro";
import CuriosityCard from "./CuriosityCard.astro";
import Footer from "./Footer.astro";
import Layout from "./Layout.astro";
import Slideshow from "./Slideshow.astro";
import { sortCuriosityNotes } from "../config/curiosity";
import { absoluteUrl, personJsonLd } from "../config/seo";
import { site } from "../config/site";

const notes = await getCollection("curiosity");
const sortedNotes = sortCuriosityNotes(notes);
const latestNotes = sortedNotes.slice(0, 3);
const title = site.title;
const description = site.description;
const canonical = "/";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: absoluteUrl(canonical),
    description,
  },
  personJsonLd(),
];
---

<Layout title={title} description={description} canonical={canonical} structuredData={structuredData} showFooter={false}>
  <section class="section-block">
    <div class="site-container home-columns">
      <div class="home-left-column home-hero">
        <h1>Good things rarely start clear.</h1>
        <h4>Here you'll find things I build, think about, and care about.</h4>
        <p class="home-section-body">Send me a message, or see the stuff that keeps me busy.</p>
        <div class="home-hero-buttons flex flex-col gap-3 sm:flex-row">
          <ButtonLink href={site.emailHref}>Email me</ButtonLink>
          <ButtonLink href="/#work" variant="secondary">See more</ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="work-section">
    <div class="site-container py-[60px] pb-[40px] md:pt-[90px] md:pb-[70px]">
      <div class="home-columns">
        <div class="home-copy-block">
          <h2>Products start <br class="hidden md:block" />as chaos.</h2>
          <h4>My work is finding direction before the chaos turns into cost.</h4>
        </div>

        <div class="home-work-body home-section-body">
          <h4>
            Ambiguity <br class="hidden md:block" />
            <span class="home-work-callout-line">to momentum.</span>
          </h4>
          <p>I shape and visualize the future, then use it to rally the team to build it with me. When things seem impossible, I find an alternative path.</p>
          <p>These are some products I’ve built.</p>
        </div>
      </div>
    </div>
    <Slideshow />
  </section>

  <section class="bg-white py-[60px] md:py-[100px]">
    <div class="site-container">
      <div class="home-columns">
        <h2>Better ideas <br class="hidden md:block" />begin with better <br class="hidden md:block" />conversations.</h2>

        <div class="home-copy-block">
          <h4>Things you only learn by talking to real people.</h4>
          <p class="home-section-body">I follow my curiosity, talk with people, and learn how better questions can change the way we think.</p>
          <p class="home-section-body">This is what those curiosity conversations reveal.</p>
        </div>
      </div>

      <div class="mt-[30px] grid gap-[30px] md:mt-[50px]">
        <div class="grid gap-5 md:grid-cols-3">
          {latestNotes.map((note, index) => <CuriosityCard note={note} notes={sortedNotes} index={index} />)}
        </div>

        <div class="[&_.button-link]:w-full md:flex md:justify-center md:[&_.button-link]:w-auto">
          <ButtonLink href="/curiosity" variant="secondary">See more notes</ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="home-contact-panel flex flex-col bg-[var(--color-black)] text-white">
    <div class="home-contact-stage">
      <div class="home-contact-content w-full py-[60px]">
        <div class="site-container home-columns">
          <div class="home-left-column home-copy-block home-contact-cta">
            <h2>Adventures do not start themselves.</h2>
            <h4>Share an idea, <br class="hidden md:block" />a thought, or just say hi.</h4>
            <p class="home-section-body">Great things can only happen when someone makes the first move.</p>
            <div class="contact-buttons flex flex-col gap-3 sm:flex-row">
              <ButtonLink href={site.emailHref}>Email me</ButtonLink>
              <ButtonLink href={site.linkedinHref} variant="secondary">Connect on LinkedIn</ButtonLink>
            </div>
          </div>
        </div>
      </div>
    </div>
    <Footer variant="dark" />
  </section>
</Layout>

<style>
  .home-columns {
    display: grid;
    gap: 24px;
  }

  .home-hero {
    display: grid;
    gap: 20px;
  }

  .home-copy-block {
    display: grid;
    gap: 20px;
  }

  .home-hero-buttons {
    margin-top: 8px;
  }

  .contact-buttons {
    margin-top: 8px;
  }

  .home-contact-panel {
    --home-footer-height: 82px;
    --footer-height: var(--home-footer-height);

    display: flex;
    flex-direction: column;
    background: var(--color-black);
    color: var(--color-white);
  }

  .home-contact-stage {
    min-height: calc(100svh - var(--header-height) - var(--footer-height));
    padding-bottom: 80px;
  }

  .home-contact-content {
    width: 100%;
  }

  .home-contact-cta {
    margin-top: clamp(96px, 18vh, 220px);
  }

  @media (max-width: 767px) {
    .home-contact-cta {
      margin-top: clamp(72px, 14vh, 140px);
    }
  }

  .home-section-body,
  .home-section-body p {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 150%;
  }

  .home-work-body {
    display: grid;
    gap: 20px;
  }

  .home-work-callout-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .home-contact-panel {
      --home-footer-height: 83px;
    }

    .home-contact-content {
      padding-top: 0;
    }

    .home-columns {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      column-gap: 80px;
      align-items: start;
    }

    .home-left-column {
      grid-column: 1;
    }

    .home-section-body,
    .home-section-body p {
      font-size: 18px;
      line-height: 155%;
    }

    .home-work-body {
      align-self: end;
    }

  }
</style>
