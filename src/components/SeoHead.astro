---
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const pageTitle = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonical = Astro.props.canonical ?? Astro.url.pathname;
const type = Astro.props.type ?? "website";
const canonicalUrl = new URL(canonical, site.url);
const ogImage = Astro.props.ogImage ?? site.ogImage;
const ogImageAlt = Astro.props.ogImageAlt ?? site.ogImageAlt;
const ogImageWidth = Astro.props.ogImageWidth ?? site.ogImageWidth;
const ogImageHeight = Astro.props.ogImageHeight ?? site.ogImageHeight;
const ogImageUrl = ogImage ? new URL(ogImage, site.url) : undefined;
const twitterCard = ogImageUrl ? "summary_large_image" : "summary";
const structuredDataItems = Astro.props.structuredData
  ? Array.isArray(Astro.props.structuredData)
    ? Astro.props.structuredData
    : [Astro.props.structuredData]
  : [];
const stringifyJsonLd = (item: Record<string, unknown>) => JSON.stringify(item).replace(/</g, "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{Astro.props.robots && <meta name="robots" content={Astro.props.robots} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImageUrl && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageUrl && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
{type === "article" && Astro.props.publishedDate && <meta property="article:published_time" content={Astro.props.publishedDate} />}
{type === "article" && Astro.props.modifiedDate && <meta property="article:modified_time" content={Astro.props.modifiedDate} />}
{type === "article" && Astro.props.author && <meta property="article:author" content={Astro.props.author} />}
{structuredDataItems.map((item) => <script type="application/ld+json" set:html={stringifyJsonLd(item)} />)}
