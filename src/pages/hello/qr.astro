---
import Layout from "../../components/Layout.astro";

const robots = "noindex, nofollow, noarchive, nosnippet";
---

<Layout title="Coen Claassen QR" description="QR code for Coen Claassen's contact page." canonical="/hello/qr" robots={robots}>
  <section class="qr-page" aria-label="QR code for Coen Claassen's contact page" data-qr-page>
    <img src="/images/hello/qr.png" alt="QR code that opens Coen Claassen's contact page" width="1000" height="1000" />
  </section>
</Layout>

<style>
  :global(html),
  :global(body) {
    background: #000;
  }

  .qr-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 0 12vw;
    background: #000;
  }

  .qr-page img {
    width: min(76vw, 480px);
    height: auto;
  }
</style>

<script>
  const qrPage = document.querySelector("[data-qr-page]");

  qrPage?.addEventListener("click", async () => {
    if (document.fullscreenElement === qrPage) return;

    await qrPage.requestFullscreen?.();
  });
</script>
