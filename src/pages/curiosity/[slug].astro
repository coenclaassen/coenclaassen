---
import { getCollection } from "astro:content";
import CuriosityNotePage from "../../components/CuriosityNotePage.astro";
import { getCuriosityPublicSlug } from "../../config/curiosity";

export async function getStaticPaths() {
  const notes = await getCollection("curiosity");

  return notes.map((entry) => ({
    params: { slug: getCuriosityPublicSlug(entry, notes) },
    props: { entry, notes },
  }));
}
---

<CuriosityNotePage entry={Astro.props.entry} notes={Astro.props.notes} />
